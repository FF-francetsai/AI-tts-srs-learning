  "stage": 3
 },
 {
  "id": "27",
  "zh": "聯邦學習",
  "en": "Federated Learning",
  "def": "資料留在各自裝置，只交換模型參數來共同訓練模型。",
  "stage": 3
 },
 {
  "id": "38",
  "zh": "特徵工程",
  "en": "Feature Engineering",
  "def": "從原始資料中挑選、轉換或創造對模型有用的特徵。",
  "stage": 3
 },
 {
  "id": "50",
  "zh": "隨機森林",
  "en": "Random Forest",
  "def": "結合多棵決策樹投票的模型，穩定又不易過度擬合。",
  "stage": 3
 },
 {
  "id": "52",
  "zh": "損失函數",
  "en": "Loss Function",
  "def": "衡量模型預測和正確答案差距的函數，訓練時要讓它變小。",
  "stage": 3
 },
 {
  "id": "53",
  "zh": "過度擬合",
  "en": "Overfitting",
  "def": "模型把訓練資料背得太熟，遇到新資料反而表現變差。",
  "stage": 3
 },
 {
  "id": "55",
  "zh": "正則化",
  "en": "Regularization",
  "def": "在訓練中加入懲罰項限制模型複雜度，降低過度擬合。",
  "stage": 3
 },
 {
  "id": "56",
  "zh": "超參數",
  "en": "Hyperparameter",
  "def": "訓練前由人設定的參數，例如學習率與批次大小。",
  "stage": 3
 },
 {
  "id": "57",
  "zh": "交叉驗證",
  "en": "Cross-Validation",
  "def": "把資料輪流切成訓練與驗證組，更可靠地評估模型表現。",
  "stage": 3
 },
 {
  "id": "62",
  "zh": "混淆矩陣",
  "en": "Confusion Matrix",
  "def": "用表格列出預測正確與錯誤的各類數量，評估分類模型。",
  "stage": 3
 },
 {
  "id": "63",
  "zh": "梯度下降",
  "en": "Gradient Descent",
  "def": "沿著損失下降最快的方向一步步調整參數的最佳化方法。",
  "stage": 3
 },
 {
  "id": "67",
  "zh": "激活函數",
  "en": "Activation Function",
  "def": "決定神經元輸出的非線性函數，例如 ReLU 或 Sigmoid。",
  "stage": 3
 },
 {
  "id": "68",
  "zh": "反向傳播",
  "en": "Backpropagation",
  "def": "從輸出誤差往回計算各層梯度，用來更新神經網路權重。",
  "stage": 3
 },
 {
  "id": "89",
  "zh": "詞嵌入",
  "en": "Word Embedding",
  "def": "把詞語轉成向量，讓語意相近的詞在空間中彼此靠近。",
  "stage": 3
 },
 {
  "id": "104",
  "zh": "維度災難",
  "en": "Curse of Dimensionality",
  "def": "資料維度越多，資料越稀疏，模型越難學好的現象。",
  "stage": 3
 },
 {
  "id": "154",
  "zh": "低秩適配",
  "en": "Low-Rank Adaptation",
  "def": "只訓練少量低秩矩陣就能微調大模型，省算力又省記憶體。",
  "stage": 3
 },
 {
  "id": "165",
  "zh": "人類回饋強化學習",
  "en": "Reinforcement Learning from Human Feedback",
  "def": "用人類對回答的偏好打分來訓練模型，使輸出更符合人意。",
  "stage": 3
 },
 {
  "id": "212",
  "zh": "知識蒸餾",
  "en": "Knowledge Distillation",
  "def": "讓小模型學習大模型的輸出，保留能力同時縮小體積。",
  "stage": 3
 },
 {
  "id": "214",
  "zh": "量化",
  "en": "Quantization",
  "def": "降低模型數值精度（如 16 位元轉 4 位元）以減少運算量。",
  "stage": 3
 },
 {
  "id": "236",
  "zh": "困惑度",
  "en": "Perplexity",
  "def": "衡量語言模型預測下一個字有多困惑的指標，越低越好。",
  "stage": 3
 },
 {
  "id": "268",
  "zh": "夏普利加性解釋",
  "en": "Shapley Additive Explanations",
  "def": "用賽局理論計算每個特徵對預測結果的貢獻度。",
  "stage": 3
 },
 {
  "id": "548",
  "zh": "交併比",
  "en": "Intersection over Union",
  "def": "預測框和真實框重疊面積占聯集面積的比例，評估偵測準度。",
  "stage": 3
 },
 {
  "id": "686",
  "zh": "自我監督學習",
  "en": "Self-supervised Learning",
  "def": "從資料本身自動產生學習目標，不需大量人工標註。",
  "stage": 3
 },
 {
  "id": "908",
  "zh": "直接偏好優化",
  "en": "Direct Preference Optimization",
