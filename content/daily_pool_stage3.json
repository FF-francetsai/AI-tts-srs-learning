  "stage": 3
 },
 {
  "id": "929",
  "zh": "災難性遺忘",
  "en": "Catastrophic Forgetting",
  "def": "模型學新任務後，把原本學會的知識大量遺忘的現象。",
  "stage": 3
 },
 {
  "id": "1016",
  "zh": "機器反學習",
  "en": "Machine Unlearning",
  "def": "讓已訓練模型「忘掉」特定資料的影響，用於隱私或刪除權。",
  "stage": 3
 }
